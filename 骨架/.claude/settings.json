{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(/agents/**)",
      "Bash(python3 *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(npx remotion *)",
      "Bash(npx hyperframes *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(heygen *)",
      "Bash(codex exec *)",
      "Bash(codex login status)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Edit(/发布内容/**)",
      "Edit(/固定资产/**)",
      "Edit(/交付/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import pathlib,runpy; p=pathlib.Path.cwd().resolve(); s=next((d/'\"'\"'agents/公共/工具/写入保护/hook_entry.py'\"'\"' for d in (p,*p.parents) if (d/'\"'\"'agents/公共/工具/写入保护/hook_entry.py'\"'\"').is_file()),None); runpy.run_path(str(s),run_name='\"'\"'__main__'\"'\"') if s else None'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

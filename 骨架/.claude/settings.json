{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(/agents/**)",
      "Bash(python3 *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(npx remotion *)",
      "Bash(npx hyperframes *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(heygen *)",
      "Bash(codex exec *)",
      "Bash(codex login status)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Edit(/发布内容/**)",
      "Edit(/固定资产/**)",
      "Edit(/交付/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agents/公共/工具/写入保护/protect_paths.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
